    "only_source_passing_search_records_trainable": true,
    "selected_source_and_revision_must_match_validation": true,
    "minimum_distinct_validation_prompts_per_domain": 100
  },
  "architecture": {
    "name": "portable_token_plan_pointer_transformer",
