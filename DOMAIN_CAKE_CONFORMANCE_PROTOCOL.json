    "signed_ed25519": true,
    "non_executable_safetensors_only": true,
    "deterministic_rebuild_identity": true,
    "tamper_rejection": true,
    "install_verify_remove_reinstall_identity": true,
    "three_fresh_receiver_roots": true,
    "cpu_and_cuda_execution": true,
    "core_hash_unchanged": true,
    "inactive_cake_prefill_calls": 0,
    "inactive_cake_decode_step_calls": 0
  },
  "promotion_rule": "A domain may be packaged as a candidate only after one seed passes validation. It may be promoted only after all three paired seeds, package, receiver, identity, sparse-execution, CPU/CUDA, and unopened final-test gates pass."
}
