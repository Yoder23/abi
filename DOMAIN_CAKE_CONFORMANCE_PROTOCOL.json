    "attention_heads": 4,
    "encoder_layers": 1,
    "decoder_layers": 1,
    "feedforward_width": 128,
    "pointer_width": 32,
    "dropout": 0.0,
    "maximum_source_lexemes": 96,
    "maximum_target_actions": 96,
    "physical_execution": "only the explicitly selected installed cake is loaded and invoked"
  },
  "bounded_training": {
    "primary_device": "cuda",
    "cpu_fallback_smoke_required": true,
    "optimizer": "AdamW",
    "optimizer_steps": 1200,
    "batch_size": 16,
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "gradient_clip_norm": 1.0,
