{
  "format": "abi-layercake-domain-conformance-protocol/1",
  "status": "PREREGISTERED_BEFORE_DOMAIN_CONFORMANCE_TRAINING",
  "claim_boundary": "This protocol can establish bounded retention for the declared catalog and exact sources only. It cannot establish exhaustive domain discovery or universal semantic identity.",
  "immutable_layercake_target": {
    "repository_commit": "04cf2927a16fba686cd640e18a78708e5658bbda",
    "direct_decoder_abi_version": "lc-direct-neural-decoder/1",
