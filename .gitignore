*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npz
paste_params.npz
hf_models/

# ─── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ─── Development logs ────────────────────────────────────────────────────────
*_log.txt
*_run.log
*_err.log
*.log
nib_run*.log
nib_run*.err

# ─── Temporary / scratch ─────────────────────────────────────────────────────
_c4_shards_tmp/
tmp_*/
*.tmp
*.bak

# ─── Data shards (too large for git) ─────────────────────────────────────────
data/redpajama_raw/
data/v6/
_c4_shards_tmp/
continuation_finetune_dataset.jsonl

# ─── Secrets / environment ────────────────────────────────────────────────────
.env
*.key
*.pem
secrets.json

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Build artifacts ─────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
.pytest_cache/

# ─── Test scaffolding ─────────────────────────────────────────────────────────
test_cortana_stress/
test_cortana_prod_stress/
test_governor_stress/
test_receipts_stress/
test_semantic_stress/
test_skills_stress/
test_vdc_stress/
test_verifier_mem/
tmp_autocortana/
tmp_guard_test/

# Large local research ledgers are preserved on disk. Release evidence and
# deployable reference artifacts are force-added explicitly.
*_results.json
results/*
run_logs/

# Compact ABI V2 code-linked evidence is part of the public technical record.
# The external reproduction zip itself remains a local handoff payload; its
# member manifest and receipt are tracked.
!results/abi_v2/
!results/abi_v2/**
results/abi_v2/external_reproduction/*.zip

# Final-mile release payloads and custody material stay out of Git. Compact
# manifests, public signatures, receipts, and reports are force-added.
results/abi_final_mile/custody/
results/abi_final_mile/*.zip
results/abi_final_mile/abi-release/*.abi
external-reproduction/

# The default branch is a curated source release. Historical root ledgers and
# generated catalogs remain available on the research-history-v1089 branch
# and may remain in a local checkout without appearing as untracked files.
/catalogs/
/*.json
/*.py
/*.md
!/README.md
!/AGENTS.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CHANGELOG.md

# Historical generated catalogs larger than 1 MiB are preserved locally and
# content-addressed by ABI_LOCAL_RESEARCH_ARTIFACTS_MANIFEST_V1.json. Their
# generators, protocols, compact manifests, decisions, and hashes remain in
# Git. Do not delete these local files when cleaning a checkout.
catalogs/broad_corpus_grounded_english_v1.json
catalogs/broad_natural_conversation_search_v1.json
catalogs/broad_natural_conversation_search_v2.json
catalogs/broad_natural_conversation_search_v2_shards16/broad_natural_conversation_search_v2_shard_*.json
catalogs/broad_natural_conversation_search_v3.json
catalogs/broad_natural_conversation_search_v3_shards16/broad_natural_conversation_search_v3_shard_*.json
catalogs/english_distinct_context_scale_v1.json
catalogs/grounded_english_reference_search_validation_v1.json
catalogs/grounded_english_reference_search_validation_v2.json
catalogs/grounded_english_reference_search_validation_v3.json
catalogs/intrinsic_english_search_validation_v83.json
catalogs/intrinsic_english_search_validation_v83_rejected_label_method.json
catalogs/natural_domain_filtered_instruction_search_v1.json
catalogs/natural_prompt_grounding_expansion_search_validation_v76.json
catalogs/supplied_context_deterministic_qualified_search_validation_v78.json
catalogs/supplied_context_natural_candidates_search_validation_v77.json
